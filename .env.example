# App
NODE_ENV=
PORT=3000
API_VERSION=v1
# Comma-separated list of allowed CORS origins (no trailing slash), e.g.
# https://app.makemybrand.com,https://admin.makemybrand.com
# Leave empty to allow any origin (local dev only).
CORS_ORIGINS=
# Set to 'true' so the app applies pending DB migrations on startup (recommended
# for staging/prod, and required on hosts where you can't run `npm run migrate`
# over SSH, e.g. Hostinger). Leave empty/false locally and migrate by hand.
RUN_MIGRATIONS_ON_BOOT=
# Comma-separated feature_types keys whose quota limit is NOT enforced, e.g.
# `storage` or `storage,downloads`. Empty = everything is enforced.
#
# Usage keeps being recorded while a feature is relaxed, so turning enforcement
# back on needs no backfill — unset this and restart. The boot log warns on every
# start while it is set, because a suspended limit is meant to be temporary.
#
# Affects the account allowance only. The per-FILE upload cap (10 MB, in
# services/userUpload.service.js) is a separate guard and stays on.
QUOTA_RELAXED_FEATURES=

# Notifications
#
# NOTIFY_JOBS_ENABLED=false is the kill switch: the scheduled, behavioural,
# campaign and cleanup jobs all stand down without a deploy. Event-triggered
# notifications (payment failed, trial started) still send — those are
# transactional, and stopping them would break receipts rather than stop spam.
NOTIFY_JOBS_ENABLED=true
# Per-user fatigue ceilings, counted over PROMOTIONAL notifications only.
# NOTIFY_MIN_GAP_MINUTES is the one that actually prevents "six notifications in
# one morning": a daily cap alone still permits all three at 09:00:01, because
# the scans run within minutes of each other.
NOTIFY_MAX_PER_DAY=3
NOTIFY_MAX_PER_WEEK=10
NOTIFY_MIN_GAP_MINUTES=45
# Quiet hours on the IST clock, [start, end). A promotional notification decided
# inside the window is stored immediately with a deferred delivery time, so a
# retry cannot queue a second copy.
NOTIFY_QUIET_START_HOUR=21
NOTIFY_QUIET_END_HOUR=9
# India-only product, so one fixed offset (+05:30, no DST). Revisit the whole
# quiet-hours model, not just this number, if MMB goes multi-region.
NOTIFY_TZ_OFFSET_MINUTES=330
# Retention for user_notifications, by state. Nothing is derived from these rows
# except the fatigue counters (7-day lookback), so pruning is safe.
NOTIFY_RETENTION_DISMISSED_DAYS=30
NOTIFY_RETENTION_READ_DAYS=90
NOTIFY_RETENTION_UNREAD_DAYS=180
# Fan-out batching. The per-run ceiling makes a runaway scan loud and bounded
# rather than fatal.
NOTIFY_BATCH_SIZE=500
NOTIFY_MAX_ROWS_PER_RUN=50000

# Database
DB_HOST=
DB_PORT=3306
DB_NAME=makemybrand
DB_USER=
DB_PASSWORD=

# Redis
REDIS_URL=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Invoices & receipts (GET /subscriptions/payments/:uid/document). The supplier
# block printed on every tax invoice. A blank GSTIN renders as "registration
# pending" rather than failing the document. SELLER_STATE decides whether a
# buyer sees CGST+SGST (same state) or IGST (any other) — labelling only, the
# charged amount is the flat rate in src/utils/gst.js either way.
SELLER_NAME=MakeMyBrand
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=
SELLER_STATE_CODE=
SELLER_EMAIL=
# Services Accounting Code printed on the invoice line. 998314 = IT design and
# development services, the usual code for SaaS.
SELLER_SAC_CODE=998314

# SMS OTP (Ping4SMS). The sms text must match the DLT template registered against
# PING4SMS_TEMPLATE_ID character-for-character — see DLT_TEMPLATE in src/utils/otpHelper.js.
PING4SMS_API_URL=https://site.ping4sms.com/api/smsapi
PING4SMS_API_KEY=
PING4SMS_SENDER_ID=
PING4SMS_TEMPLATE_ID=
PING4SMS_ROUTE=2
# Optional override — leave it out entirely unless you mean it. By default real sends
# happen everywhere except development/test, which rely on the OTP that send-otp echoes
# in the response; staging and production both text for real. Uncomment as true to force
# a real send from dev (to verify vendor wiring), or as false to stop sends anywhere.
# Staging therefore needs real PING4SMS_* credentials above.
# SMS_ENABLED=true

# Mounts POST /api/v1/dev/test-sms, which texts a real OTP so you can verify the
# Ping4SMS wiring from development, where the normal OTP path never reaches the vendor.
# Unauthenticated and it spends real credits — development only, never staging or
# production (the mount also refuses NODE_ENV=production outright).
# ENABLE_SMS_TEST=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
