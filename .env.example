# App
NODE_ENV=
PORT=3000
API_VERSION=v1
# Comma-separated list of allowed CORS origins (no trailing slash), e.g.
# https://app.makemybrand.com,https://admin.makemybrand.com
# Leave empty to allow any origin (local dev only).
CORS_ORIGINS=
# Set to 'true' so the app applies pending DB migrations on startup (recommended
# for staging/prod, and required on hosts where you can't run `npm run migrate`
# over SSH, e.g. Hostinger). Leave empty/false locally and migrate by hand.
RUN_MIGRATIONS_ON_BOOT=

# Database
DB_HOST=
DB_PORT=3306
DB_NAME=makemybrand
DB_USER=
DB_PASSWORD=

# Redis
REDIS_URL=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
