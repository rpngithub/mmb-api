# App
NODE_ENV=
PORT=3000
API_VERSION=v1
# Comma-separated list of allowed CORS origins (no trailing slash), e.g.
# https://app.makemybrand.com,https://admin.makemybrand.com
# Leave empty to allow any origin (local dev only).
CORS_ORIGINS=
# Set to 'true' so the app applies pending DB migrations on startup (recommended
# for staging/prod, and required on hosts where you can't run `npm run migrate`
# over SSH, e.g. Hostinger). Leave empty/false locally and migrate by hand.
RUN_MIGRATIONS_ON_BOOT=

# Database
DB_HOST=
DB_PORT=3306
DB_NAME=makemybrand
DB_USER=
DB_PASSWORD=

# Redis
REDIS_URL=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP (Ping4SMS). The sms text must match the DLT template registered against
# PING4SMS_TEMPLATE_ID character-for-character — see DLT_TEMPLATE in src/utils/otpHelper.js.
PING4SMS_API_URL=https://site.ping4sms.com/api/smsapi
PING4SMS_API_KEY=
PING4SMS_SENDER_ID=
PING4SMS_TEMPLATE_ID=
PING4SMS_ROUTE=2
# Optional override — leave it out entirely unless you mean it. By default real sends
# happen only outside development/staging/test, so dev and staging rely on the OTP that
# send-otp echoes in the response. Uncomment as true to force a real send from a
# non-production env (to verify vendor wiring), or as false to stop sends anywhere.
# SMS_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
