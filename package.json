{
  "name": "mmb-api",
  "version": "1.0.0",
  "description": "MakeMyBrand Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "test:prepare": "node test/prepare.js",
    "test": "node test/prepare.js && node --test --test-concurrency=1 test/api.test.js",
    "test:only": "node --test --test-concurrency=1 test/api.test.js",
    "db:create": "node src/db/create-database.js",
    "migrate": "node src/db/migrate.js",
    "migrate:undo:all": "node src/db/migrate.js --undo",
    "seed": "node src/db/seed.js",
    "seed:undo": "node src/db/seed.js --undo",
    "db:reset": "node src/db/migrate.js --undo && node src/db/migrate.js && node src/db/seed.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.4",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
